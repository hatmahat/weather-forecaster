# Application
APP_NAME=ML Service API
APP_VERSION=1.0.0
DEBUG=False
SQLALCHEMY_ECHO=false

# Database (required)
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/app_db

# CORS (comma-separated list of allowed origins; "*" allows all)
CORS_ORIGINS=http://localhost:3000

# Logging
# LOG_LEVEL: Valid values are DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# JSON_LOGS: Set to true for JSON formatted logs (production), false for human-readable logs (development)
JSON_LOGS=false

# LOG_FILE: Optional file path to write logs. Leave empty or comment out to log only to console
LOG_FILE=

# AWS S3 (AWS_S3_BUCKET_NAME is required)
# If deploying on EC2/ECS with an IAM role, leave AWS_S3_ACCESS_KEY and AWS_S3_SECRET_KEY empty
# and set AWS_S3_USE_IAM_ROLE=true
AWS_S3_ACCESS_KEY=your-aws-access-key
AWS_S3_SECRET_KEY=your-aws-secret-key
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_PRESIGNED_URL_DURATION_MINUTES=15
AWS_S3_USE_IAM_ROLE=false

# Webhook: POSTs to WEBHOOK_URL?jobId={job_id} when a job finishes with SUCCESS / PARTIAL_SUCCESS.
# The key is sent in the X-API-Key header and must match what the receiver expects.
# Generate a secure key with: openssl rand -base64 32
# Set WEBHOOK_ENABLED=false to disable webhook calls (useful for local development / tests)
WEBHOOK_URL=http://localhost:8080/api/jobs/complete
WEBHOOK_API_KEY=your-webhook-api-key-here
WEBHOOK_ENABLED=true
