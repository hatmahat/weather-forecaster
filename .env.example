# Application
APP_NAME=Weather Forecaster API
APP_VERSION=1.0.0
DEBUG=False
SQLALCHEMY_ECHO=true

# Database
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/forecast_db

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
# LOG_LEVEL: Valid values are DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# JSON_LOGS: Set to true for JSON formatted logs (production), false for human-readable logs (development)
JSON_LOGS=false

# LOG_FILE: Optional file path to write logs. Leave empty or comment out to log only to console
# LOG_FILE=/var/log/weather-forecaster/app.log
LOG_FILE=
